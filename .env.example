# Copy to .env.local in apps/web and apps/admin as noted below.
# NEVER commit real values — .env* is gitignored except this file.

# ─── Public: safe to expose in the browser (both apps) ───────────────────
# RLS is what protects the data, not this key.
NEXT_PUBLIC_SUPABASE_URL=https://btkcyyvkchtnuoxnqpnm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Canonical public origin. Note the www — sujha.com 308s to www.sujha.com.
NEXT_PUBLIC_SITE_URL=https://www.sujha.com

# ─── apps/admin ONLY — server-side, never in a client bundle ─────────────
# Bypasses RLS entirely. Used solely for admin user provisioning.
# No NEXT_PUBLIC_ prefix, by design: that prefix would inline it into JS
# shipped to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Admin app origin, for OTP email redirect links.
NEXT_PUBLIC_ADMIN_URL=https://cms.sujha.com

# ─── Resend — notification email (RFQ / inquiry / CV) ────────────────────
# Separate from the Supabase↔Resend integration, which handles Auth OTP
# email over SMTP. This key is for our own transactional sends.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=notifications@sujha.com
INQUIRY_NOTIFICATION_TO=jhaindra@sujha.com
